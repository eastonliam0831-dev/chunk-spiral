  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.chunkspiral.ChunkSpiralClient"],
    "modmenu": ["com.chunkspiral.ModMenuIntegration"]
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
